{
  "name": "pinel",
  "displayName": "Pinel - Pi for VS Code",
  "publisher": "hiss",
  "description": "Pinel - 在 VS Code 中使用 Pi 编码智能体",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "activationEvents": [
    "onView:pinel.chatView",
    "onView:pinel.sessionHistory"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "pinel.openPanel",
        "title": "Pinel: 打开聊天面板",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pinel.abort",
        "title": "Pinel: 中断当前操作",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pinel.newSession",
        "title": "Pinel: 新会话",
        "icon": "$(add)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pinel",
          "title": "Pinel",
          "icon": "media/pinel-icon.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "pinel-chat",
          "title": "Pinel",
          "icon": "media/pinel-icon.svg"
        }
      ]
    },
    "views": {
      "pinel": [
        {
          "type": "webview",
          "id": "pinel.sessionHistory",
          "name": "会话历史",
          "icon": "media/pinel-icon.svg"
        }
      ],
      "pinel-chat": [
        {
          "type": "webview",
          "id": "pinel.chatView",
          "name": "聊天",
          "icon": "media/pinel-icon.svg"
        }
      ]
    },
    "configuration": {
      "title": "Pinel",
      "properties": {
        "pinel.piPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "pi CLI 可执行文件路径（留空则自动在 PATH 中查找）。例如 `C:/Users/you/AppData/Roaming/npm/pi.cmd`。修改后需重新加载窗口生效。"
        },
        "pinel.sessionDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "pi 会话存储目录（留空则使用 pi 默认 `~/.pi/agent/sessions/`）。自定义目录下会话文件直接存放（不按工作目录分子目录），会话历史列表也扫描此目录。"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js && node webview-ui/esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:webview": "node webview-ui/esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production && node webview-ui/esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc -p webview-ui/tsconfig.json",
    "lint": "eslint src",
    "test": "node scripts/clean-test-userdata.mjs && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
