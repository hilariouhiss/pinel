{
  "name": "pinel",
  "displayName": "Pinel - Pi for VS Code",
  "publisher": "hilariouhiss",
  "description": "Pinel - Use Pi in VS Code",
  "version": "0.1.4",
  "repository": {
    "type": "git",
    "url": "https://github.com/hilariouhiss/pinel.git"
  },
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "main": "./dist/extension.js",
  "icon": "media/pi-icon.png",
  "contributes": {
    "commands": [
      {
        "command": "pinel.openPanel",
        "title": "Pinel: Open Chat Panel",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "pinel.abort",
        "title": "Pinel: Abort Current Operation",
        "icon": "$(debug-stop)"
      },
      {
        "command": "pinel.newSession",
        "title": "Pinel: New Session",
        "icon": "$(add)"
      },
      {
        "command": "pinel.editPrompt",
        "title": "Pinel: Edit Prompt"
      }
    ],
    "keybindings": [
      {
        "command": "pinel.editPrompt",
        "key": "ctrl+g",
        "when": "pinel.inputFocused"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "pinel",
          "title": "Pinel",
          "icon": "media/pi-glyph.svg"
        }
      ],
      "secondarySidebar": [
        {
          "id": "pinel-chat",
          "title": "Pinel",
          "icon": "media/pi-glyph.svg"
        }
      ]
    },
    "views": {
      "pinel": [
        {
          "type": "webview",
          "id": "pinel.sessionHistory",
          "name": "Session History",
          "icon": "media/pi-glyph.svg"
        }
      ],
      "pinel-chat": [
        {
          "type": "webview",
          "id": "pinel.chatView",
          "name": "Chat",
          "icon": "media/pi-glyph.svg"
        }
      ]
    },
    "configuration": {
      "title": "Pinel",
      "properties": {
        "pinel.piPath": {
          "type": "string",
          "default": "",
          "markdownDescription": "pi CLI executable path (leave empty to search in PATH). For example, `C:/Users/you/AppData/Roaming/npm/pi.cmd`. Changes require a window reload to take effect."
        },
        "pinel.sessionDir": {
          "type": "string",
          "default": "",
          "markdownDescription": "pi session storage directory (leave empty to use pi's default `~/.pi/agent/sessions/`). Session files are stored directly in the custom directory (not organized by workspace), and the session history list also scans this directory."
        },
        "pinel.showSessionStats": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "Display a session info bar above the input field (token usage / cost / context usage progress / cache hit rate). Data comes from pi's get_session_stats and updates with each turn end and session switch."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run check-plugin && npm run check:smooth-text && npm run check:at-refs && npm run check:composer-md && npm run lint && node esbuild.js && node webview-ui/esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:webview": "node webview-ui/esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run check-plugin && npm run check:smooth-text && npm run check:at-refs && npm run check:composer-md && npm run lint && node esbuild.js --production && node webview-ui/esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit && tsc -p webview-ui/tsconfig.json",
    "check-plugin": "tsc --noEmit --strict --skipLibCheck --target es2022 --module es2022 --lib es2022 --types node --ignoreConfig ../pi/pinel.ts",
    "check:smooth-text": "node --experimental-strip-types webview-ui/smooth-text.check.mjs",
    "check:at-refs": "node --experimental-strip-types webview-ui/at-refs.check.mjs",
    "check:composer-md": "node --experimental-strip-types webview-ui/composer-md.check.mjs",
    "smoke:plugin": "node scripts/pinel-plugin-smoke.mjs",
    "install:all": "node scripts/install-all.mjs",
    "lint": "eslint src",
    "test": "node scripts/clean-test-userdata.mjs && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/vscode": "^1.125.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "npm-run-all": "^4.1.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "dependencies": {
    "ignore": "^5.3.2",
    "lucide-static": "^1.34.0",
    "remark-gfm": "^4.0.1"
  }
}
